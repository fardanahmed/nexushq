---
import { ClientRouter } from 'astro:transitions';
import Navbar from '../components/shared/Navbar';
import Footer from '../components/shared/Footer';
import '../styles/globals.css';
import { getSiteSettings } from '../lib/content-api';
import type { SiteData } from '../types';

interface Props {
  title?: string;
  description?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, schema } = Astro.props;

// Fetch site-wide data for SEO, metadata, and footer
const siteData = await getSiteSettings<SiteData>('site_data');
const defaultTitle = siteData 
  ? `${siteData.abbreviation} | ${siteData.name}`
  : 'NexusHQ | The Coaching Platform for Modern Mentors';

const defaultDesc = siteData?.tagline || 'The all-in-one platform for coaches, tutors, and mentors to manage clients, bookings, and sessions.';
const displayTitle = title ? `${title} | NexusHQ` : defaultTitle;
const displayDesc = description || defaultDesc;
---

<!doctype html>
<html lang="en" class="dark" style="scrollbar-gutter: stable;">
  <head>
    <ClientRouter />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#020408" />
    
    <title>{displayTitle}</title>
    <meta name="description" content={displayDesc} />
    
    <!-- OpenGraph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={displayTitle} />
    <meta property="og:description" content={displayDesc} />
    <meta property="og:image" content="/og-image.png" />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={displayTitle} />
    <meta property="twitter:description" content={displayDesc} />
    <meta property="twitter:image" content="/og-image.png" />

    <!-- Google Fonts: Inter, Outfit, JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&family=Outfit:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

    <!-- Enforce dark mode to match 3D concept aesthetics -->
    <script is:inline>
      document.documentElement.classList.add('dark');
      if (typeof localStorage !== 'undefined') {
        localStorage.setItem('theme', 'dark');
      }
    </script>
    {schema && <script type="application/ld+json" is:inline set:html={JSON.stringify(schema).replace(/</g, '\\u003c').replace(/>/g, '\\u003e')} />}
  </head>
  <body class="bg-background text-foreground font-sans antialiased">
    <!-- Accessible Skip to Content Link for Keyboard / Screen Reader Navigation -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:px-5 focus:py-2.5 focus:bg-emerald-500 focus:text-black focus:font-bold focus:rounded-xl focus:shadow-2xl focus:ring-2 focus:ring-white"
    >
      Skip to main content
    </a>

    <div class="flex min-h-screen flex-col">
      <!-- client:load is needed for mobile collapsible navigation and theme-switching interactions -->
      <header>
        <Navbar client:load />
      </header>
      <main id="main-content" class="flex-1 focus:outline-none" tabindex="-1">
        <slot />
      </main>
      <!-- Footer handles dynamic data passed from server frontmatter -->
      <Footer siteData={siteData} />
    </div>
  </body>
</html>
