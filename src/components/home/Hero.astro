---
import { getSiteSettings } from '../../lib/content-api';
import type { HeroContent } from '../../types';
import HeroVisual from './HeroVisual';
import HeroScrollBackground from './HeroScrollBackground';

const heroContent = await getSiteSettings<HeroContent>('hero_content');

const defaultHeroContent: HeroContent = {
  headline: 'Run your coaching practice from one place.',
  subheadline:
    'Clients book and pay, you meet on video, and notes and progress stay with the client. Built for solo coaches, tutors and mentors.',
  ctaPrimary: 'Join the waitlist',
  ctaSecondary: 'See features',
};

const headline = heroContent?.headline || defaultHeroContent.headline;
const subheadline = heroContent?.subheadline || defaultHeroContent.subheadline;
const ctaPrimary = heroContent?.ctaPrimary || defaultHeroContent.ctaPrimary;
const ctaSecondary = heroContent?.ctaSecondary || defaultHeroContent.ctaSecondary;
---

<section class="relative w-full overflow-hidden">
  <HeroScrollBackground client:load />

  <div class="container relative z-10 mx-auto max-w-6xl px-6 pt-28 pb-16 lg:pt-36 lg:pb-24">
    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-12">
      <div class="hero-rise space-y-8 lg:col-span-7">
        <div class="space-y-5">
          <h1 class="max-w-[14ch] text-display">{headline}</h1>
          {subheadline && (
            <p class="max-w-[52ch] text-lead text-mist">{subheadline}</p>
          )}
        </div>

        {(ctaPrimary || ctaSecondary) && (
          <div class="flex flex-col gap-3 sm:flex-row">
            {ctaPrimary && (
              <a
                href="/#join"
                class="inline-flex h-12 items-center justify-center rounded-control bg-emerald px-6 text-base font-semibold text-ink transition-colors duration-150 hover:bg-sea"
              >
                {ctaPrimary}
              </a>
            )}
            {ctaSecondary && (
              <a
                href="/features"
                class="inline-flex h-12 items-center justify-center rounded-control border border-hairline px-6 text-base font-semibold text-chalk transition-colors duration-150 hover:bg-slate-2"
              >
                {ctaSecondary}
              </a>
            )}
          </div>
        )}
        <p class="text-sm text-mist">Private beta. No card needed to join the list.</p>
      </div>

      <div class="w-full lg:col-span-5" transition:persist>
        <HeroVisual client:load />
      </div>
    </div>
  </div>
</section>
