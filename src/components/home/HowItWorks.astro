---
import PlatformShowcase from './PlatformShowcase';

// A real sequence: setup, book, meet, track. Numbers carry meaning here.
const steps = [
  {
    title: 'Connect your calendar and Stripe',
    description: 'Set your availability once. Payments go to your own Stripe account.',
  },
  {
    title: 'Clients book and pay',
    description: 'Share one link. A client picks a slot and pays before the session is confirmed.',
  },
  {
    title: 'Meet on video',
    description: 'The session starts from your dashboard. No links to hunt for.',
  },
  {
    title: 'Keep notes with the client',
    description: 'Session notes, files and progress stay on the client record for next time.',
  },
];
---

<section class="py-24 lg:py-32">
  <div class="container mx-auto max-w-6xl px-6">
    <div class="mb-16 max-w-2xl">
      <h2 class="text-h2">Your whole coaching business, in order.</h2>
      <p class="mt-4 text-lead text-mist">
        Four tools today, one flow with NexusHQ. The admin happens around the session, not instead of it.
      </p>
    </div>

    <ol class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      {steps.map((step, i) => (
        <li class="border-t border-hairline pt-5">
          <span class="font-heading text-h3 tabular-nums text-sea">{i + 1}</span>
          <h3 class="mt-3 text-h4">{step.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-mist">{step.description}</p>
        </li>
      ))}
    </ol>

    <PlatformShowcase client:visible />
  </div>
</section>
