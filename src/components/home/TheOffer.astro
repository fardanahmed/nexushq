---
const benefits = [
  {
    title: 'Your founding price does not go up',
    text: 'Pay the beta rate for as long as you keep the subscription, whatever the public price becomes.',
  },
  {
    title: 'We move your clients in for you',
    text: 'Existing clients, upcoming bookings and billing history are imported from your current tools at no charge.',
  },
  {
    title: 'A direct line to the people building it',
    text: 'Founding members share a channel with the team and shape what gets built next.',
  },
];
---

<section class="border-t border-hairline py-24 lg:py-32">
  <div class="container mx-auto max-w-6xl px-6">
    <div class="mb-12 max-w-2xl">
      <h2 class="text-h2">Founding members.</h2>
      <p class="mt-4 text-lead text-mist">
        The first fifty coaches in the private beta get the founding rate and hands-on setup.
      </p>
    </div>

    <div class="grid overflow-hidden rounded-object border border-hairline bg-slate md:grid-cols-12">
      <ul class="space-y-8 p-8 md:col-span-8 md:p-10">
        {benefits.map((b) => (
          <li class="max-w-[56ch]">
            <h3 class="text-h4">{b.title}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-mist">{b.text}</p>
          </li>
        ))}
      </ul>
      <div class="flex flex-col justify-center gap-6 border-t border-hairline bg-slate-2 p-8 md:col-span-4 md:border-t-0 md:border-l md:p-10">
        <div>
          <div class="text-sm text-mist">Founding rate</div>
          <div class="mt-1 flex items-baseline gap-1 font-heading">
            <span class="text-5xl font-semibold tabular-nums text-brass">$99</span>
            <span class="text-base text-mist">/month</span>
          </div>
          <div class="mt-1 text-sm text-mist">50 places. Billed monthly, cancel any time.</div>
        </div>
        <a
          href="/#join"
          class="inline-flex h-12 items-center justify-center rounded-control bg-emerald px-6 text-base font-semibold text-ink transition-colors duration-150 hover:bg-sea"
        >
          Join the waitlist
        </a>
      </div>
    </div>
  </div>
</section>
