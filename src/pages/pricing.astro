---
import Layout from '../layouts/Layout.astro';
import PricingGrid from '../components/pricing/PricingGrid';
import TheOffer from '../components/home/TheOffer.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": Astro.url.href,
  "url": Astro.url.href,
  "name": "Pricing",
  "description": "Simple, transparent pricing for every stage of your coaching business.",
};
---

<Layout title="Pricing" schema={schema}>
  <section class="pt-28 pb-12 text-center lg:pt-36 lg:pb-16">
    <div class="container mx-auto max-w-6xl px-6">
      <div class="mx-auto max-w-2xl">
        <h1 class="text-display">Simple, transparent pricing.</h1>
        <p class="mx-auto mt-5 max-w-[48ch] text-lead text-mist">
          One monthly price, no fees per booking. Pick the plan that matches your roster and change it when the roster changes.
        </p>
      </div>
    </div>
  </section>

  <section class="pb-24 lg:pb-32">
    <div class="container mx-auto max-w-6xl px-6">
      <PricingGrid client:load />
    </div>
  </section>

  <TheOffer />
</Layout>
