---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Privacy" description="NexusHQ privacy notice for the private beta.">
  <section class="pt-28 pb-24 lg:pt-36 lg:pb-32">
    <div class="container mx-auto max-w-6xl px-6">
      <div class="max-w-2xl">
        <h1 class="text-display">Privacy</h1>
        <p class="mt-5 text-lead text-mist">
          NexusHQ is in private beta. This page will carry the full privacy policy before launch. Until then, the only data the site stores is what you type into the waitlist and contact forms, and it is used only to reply to you.
        </p>
      </div>
    </div>
  </section>
</Layout>
