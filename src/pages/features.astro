---
import Layout from '../layouts/Layout.astro';
import FeaturesFilter from '../components/features/FeaturesFilter';
import Integrations from '../components/home/Integrations';
import { getFeatures } from '../lib/content-api';

const features = await getFeatures();

const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": Astro.url.href,
  "url": Astro.url.href,
  "name": "Platform Features",
  "description": "What NexusHQ does for a coaching practice: scheduling, client management, video sessions, and payments in one platform.",
  "mainEntity": {
    "@type": "ItemList",
    "numberOfItems": features.length,
    "itemListElement": features.map((feature, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "item": {
        "@type": "SoftwareApplication",
        "name": feature.title,
        "description": feature.description,
        "url": `${Astro.url.href}#${feature.id || index}`
      }
    }))
  }
};
---

<Layout title="Features" schema={schema}>
  <section class="pt-28 pb-12 lg:pt-36 lg:pb-16">
    <div class="container mx-auto max-w-6xl px-6">
      <div class="max-w-2xl">
        <h1 class="text-display">Booking, payments, video and notes.</h1>
        <p class="mt-5 max-w-[52ch] text-lead text-mist">
          Booking, payments, video and client notes. Each one is plain on its own, and they share one client record.
        </p>
      </div>
    </div>
  </section>

  <section class="pb-24 lg:pb-32">
    <div class="container mx-auto max-w-6xl px-6">
      <FeaturesFilter client:load initialFeatures={features} />
    </div>
  </section>

  <Integrations />

  <section class="border-t border-hairline py-24 lg:py-32">
    <div class="container mx-auto max-w-6xl px-6">
      <div class="max-w-2xl space-y-6">
        <h2 class="text-h2">Want to try it first?</h2>
        <p class="text-lead text-mist">
          NexusHQ is in private beta. Join the list and we tell you when a place opens.
        </p>
        <div class="flex flex-col gap-3 sm:flex-row">
          <a href="/#join" class="inline-flex h-12 items-center justify-center rounded-control bg-emerald px-6 text-base font-semibold text-ink transition-colors duration-150 hover:bg-sea">
            Join the waitlist
          </a>
          <a href="/pricing" class="inline-flex h-12 items-center justify-center rounded-control border border-hairline px-6 text-base font-semibold text-chalk transition-colors duration-150 hover:bg-slate-2">
            See pricing
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
