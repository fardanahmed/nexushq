---
import Layout from '../layouts/Layout.astro';
import FeaturesFilter from '../components/features/FeaturesFilter';
import Integrations from '../components/home/Integrations';
import { getFeatures } from '../lib/content-api';

const features = await getFeatures();

const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": Astro.url.href,
  "url": Astro.url.href,
  "name": "Platform Features",
  "description": "Everything you need to run a professional coaching business — scheduling, client management, video sessions, and payments in one platform.",
  "mainEntity": {
    "@type": "ItemList",
    "numberOfItems": features.length,
    "itemListElement": features.map((feature, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "item": {
        "@type": "SoftwareApplication",
        "name": feature.title,
        "description": feature.description,
        "url": `${Astro.url.href}#${feature.id || index}`
      }
    }))
  }
};
---

<Layout title="Platform Features" schema={schema}>
  <!-- Hero Section -->
  <section class="relative pt-32 pb-16 md:pt-40 md:pb-24 w-full overflow-hidden bg-gradient-to-b from-[#020408]/80 to-transparent">
    <div class="absolute inset-0 bg-radial-at-t from-emerald-500/10 via-transparent to-transparent pointer-events-none" />
    
    <div class="relative z-10 flex flex-col items-center justify-center px-6 text-center max-w-4xl mx-auto">
      <h1 class="mb-6 font-heading text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-black tracking-tighter text-white drop-shadow-lg pb-2">
        Architected for <span class="bg-gradient-to-r from-emerald-400 via-teal-300 to-amber-300 bg-clip-text text-transparent inline-block pb-1">Unmatched Impact</span>
      </h1>
      <p class="max-w-2xl text-lg text-slate-300 sm:text-xl font-medium leading-relaxed">
        Everything you need to run a high-converting mentorship practice — automated scheduling, client CRM, 4K video, and instant payouts.
      </p>
    </div>
  </section>

  <!-- Interactive Features Filter Grid Section -->
  <section class="py-12 pb-24 relative z-10">
    <div class="container mx-auto px-6 max-w-7xl">
      <FeaturesFilter client:load initialFeatures={features} />
    </div>
  </section>

  <!-- Integrations Network Graph -->
  <Integrations client:load />

  <!-- CTA Section -->
  <section class="border-t border-emerald-500/10 bg-[#020408] py-24 relative overflow-hidden">
    <div class="absolute bottom-0 right-1/4 h-80 w-80 rounded-full bg-emerald-500/5 blur-3xl pointer-events-none" />
    
    <div class="container mx-auto max-w-4xl px-6 text-center relative z-10 space-y-8">
      <h2 class="font-heading text-4xl font-black tracking-tighter sm:text-5xl text-white">
        Ready to Streamline Your Practice?
      </h2>
      <p class="text-xl text-slate-300 font-medium max-w-2xl mx-auto leading-relaxed">
        Join thousands of coaches who've replaced their patchwork of tools with one powerful platform.
      </p>
      <div class="flex flex-col justify-center gap-4 sm:flex-row pt-4">
        <a 
          href="https://app.nexushq.tech" 
          class="inline-flex items-center justify-center rounded-2xl bg-gradient-to-r from-emerald-400 via-teal-400 to-amber-300 px-8 py-4 text-base font-extrabold text-black shadow-xl shadow-emerald-500/25 transition-all duration-300 hover:scale-105 border border-emerald-300/40"
        >
          Start Free Trial
        </a>
        <a 
          href="/pricing" 
          class="inline-flex items-center justify-center rounded-2xl border border-emerald-500/20 bg-slate-900/60 px-8 py-4 text-base font-bold text-white transition-all duration-300 hover:scale-105 hover:bg-slate-900/90 hover:border-emerald-400/40"
        >
          View Pricing
        </a>
      </div>
    </div>
  </section>
</Layout>
