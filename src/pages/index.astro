---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/home/Hero.astro';
import HowItWorks from '../components/home/HowItWorks.astro';
import Integrations from '../components/home/Integrations';
import TheOffer from '../components/home/TheOffer.astro';
import JoinTeamSection from '../components/home/JoinTeamSection';

import { getSiteSettings } from '../lib/content-api';
import type { SiteData } from '../types';

// Fetch data from backend (or fallback)
const siteData = await getSiteSettings<SiteData>('site_data');

const schema = (siteData && siteData.contact) ? {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "NexusHQ",
  "applicationCategory": "BusinessApplication",
  "description": siteData.tagline || "Booking, payments, video sessions and client notes for solo coaches.",
  "url": Astro.url.href,
  "logo": new URL('/favicon.svg', Astro.url).href,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD",
    "description": "Free trial available"
  }
} : undefined;
---
<Layout schema={schema}>
  <Hero />
  <HowItWorks />
  <Integrations />
  <!-- Testimonials.tsx stays on disk, unmounted until real beta quotes exist (owner decision, 7 Nov) -->
  <TheOffer />
  <JoinTeamSection client:idle />
</Layout>
