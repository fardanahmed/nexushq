---
import Layout from '../layouts/Layout.astro';
import { getSiteSettings } from '../lib/content-api';
import type { AboutContent, SiteData } from '../types';

const defaultAboutContent: AboutContent = {
  mission: 'Our mission is to empower coaches, tutors, and mentors with the tools they need to build thriving businesses.',
  preamble: 'NexusHQ was born from a simple observation: coaches spend more time on admin than on coaching.\n\nWe built a platform that handles scheduling, payments, client management, and video sessions — so you can focus on what you do best.',
  vision: 'A world where every great coach has the tools to scale their impact, without the overhead.'
};

const defaultSiteData: SiteData = {
  name: 'NexusHQ Technologies',
  abbreviation: 'NexusHQ',
  tagline: 'The Coaching Platform for Modern Mentors',
  contact: {
    email: 'hello@nexushq.tech',
    phone: '+1-800-NEXUS-HQ',
    address: 'Remote-first, Global'
  }
};

const aboutContent = (await getSiteSettings<AboutContent>('about_content')) || defaultAboutContent;
const siteData = (await getSiteSettings<SiteData>('site_data')) || defaultSiteData;

const orgSchema = (siteData && siteData.contact) ? {
  "@type": "Organization",
  "@id": `${Astro.url.origin}/#organization`,
  "name": siteData.name,
  "alternateName": siteData.abbreviation,
  "slogan": siteData.tagline,
  "url": Astro.url.origin,
  "logo": new URL('/favicon.svg', Astro.url).href,
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": siteData.contact.phone,
    "email": siteData.contact.email,
    "contactType": "customer service"
  }
} : null;

const aboutPageSchema = {
  "@type": "AboutPage",
  "@id": Astro.url.href,
  "url": Astro.url.href,
  "name": "About NexusHQ",
  "description": aboutContent.mission,
  "about": orgSchema ? { "@id": `${Astro.url.origin}/#organization` } : undefined
};

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    aboutPageSchema,
    ...(orgSchema ? [orgSchema] : [])
  ]
};

const values = [
  { title: 'Simple first', desc: 'A coach should be able to set it up in an afternoon without reading a manual.' },
  { title: 'The coach decides', desc: 'Every feature starts with one question: does this help a coach serve a client better?' },
  { title: 'Dependable', desc: 'Your clients depend on you. We treat uptime and data safety as the product, not a feature.' },
];

---

<Layout title="About" schema={schema}>
  <section class="pt-28 pb-16 lg:pt-36 lg:pb-24">
    <div class="container mx-auto max-w-6xl px-6">
      <div class="max-w-3xl">
        <h1 class="text-display">Built by coaches, for coaches.</h1>
        <p class="mt-5 max-w-[56ch] text-lead text-mist">{aboutContent.mission}</p>
      </div>
    </div>
  </section>

  <section class="border-t border-hairline py-24 lg:py-32">
    <div class="container mx-auto max-w-6xl px-6">
      <div class="grid items-start gap-12 lg:grid-cols-12">
        <div class="space-y-5 lg:col-span-6">
          <h2 class="text-h2">Why we built it</h2>
          <div class="space-y-4 text-base leading-relaxed text-mist md:text-lg">
            {aboutContent.preamble
              .replace(/\n\n/g, '\n\n')
              .replace(/\n/g, ' ')
              .split('\n\n')
              .filter((p) => p.trim())
              .map((paragraph) => (
                <p>{paragraph.trim()}</p>
              ))}
          </div>
        </div>
        <div class="overflow-hidden rounded-object border border-hairline lg:col-span-6">
          <img src="/assets/about-us.webp" alt="Two people working at a table with a laptop" class="h-[360px] w-full object-cover" loading="lazy" width="800" height="360" />
        </div>
      </div>
    </div>
  </section>

  <section class="border-t border-hairline py-24 lg:py-32">
    <div class="container mx-auto max-w-6xl px-6">
      <h2 class="text-h2">What we hold to</h2>
      <ul class="mt-10 grid gap-10 md:grid-cols-3">
        {values.map((val) => (
          <li class="border-t border-hairline pt-5">
            <h3 class="text-h4">{val.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-mist">{val.desc}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="border-t border-hairline py-24 lg:py-32">
    <div class="container mx-auto max-w-6xl px-6">
      <blockquote class="max-w-3xl font-heading text-h3 text-chalk">&ldquo;{aboutContent.vision}&rdquo;</blockquote>
    </div>
  </section>
</Layout>
