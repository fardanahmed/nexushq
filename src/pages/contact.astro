---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/contact/ContactForm';
import { getSiteSettings } from '../lib/content-api';
import type { SiteData } from '../types';

const defaultSiteData: SiteData = {
  name: 'NexusHQ Technologies',
  abbreviation: 'NexusHQ',
  tagline: 'Booking, payments, video sessions and client notes for solo coaches',
  contact: {
    email: 'hello@nexushq.tech'
  }
};

const siteData = (await getSiteSettings<SiteData>('site_data')) || defaultSiteData;

const schema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "@id": Astro.url.href,
  "url": Astro.url.href,
  "name": "Contact Us",
  "description": "Questions about NexusHQ, the private beta or a team plan. Email or use the form.",
  "mainEntity": {
    "@type": "Organization",
    "@id": `${Astro.url.origin}/#organization`,
    "name": siteData.name,
    "alternateName": siteData.abbreviation,
    "url": Astro.url.origin,
    "contactPoint": [
      {
        "@type": "ContactPoint",
        "telephone": siteData.contact.phone,
        "email": siteData.contact.email,
        "contactType": "customer service"
      }
    ]
  }
};
---

<Layout title="Contact" schema={schema}>
  <section class="pt-28 pb-12 lg:pt-36 lg:pb-16">
    <div class="container mx-auto max-w-6xl px-6">
      <div class="max-w-2xl">
        <h1 class="text-display">Talk to us.</h1>
        <p class="mt-5 max-w-[48ch] text-lead text-mist">
          Questions about the beta, the team plan or an integration. A person reads every message.
        </p>
      </div>
    </div>
  </section>

  <section class="pb-24 lg:pb-32">
    <div class="container mx-auto max-w-6xl px-6">
      <div class="grid items-start gap-12 lg:grid-cols-12">
        <div class="space-y-10 lg:col-span-5">
          <dl class="space-y-5">
            <div>
              <dt class="text-sm text-mist">Email</dt>
              <dd class="mt-0.5">
                <a href={`mailto:${siteData.contact.email}`} class="text-chalk underline-offset-4 hover:underline">{siteData.contact.email}</a>
              </dd>
            </div>
            {siteData.contact.phone && (
              <div>
                <dt class="text-sm text-mist">Phone</dt>
                <dd class="mt-0.5 tabular-nums text-chalk">{siteData.contact.phone}</dd>
              </div>
            )}
          </dl>
        </div>
        <div class="lg:col-span-7">
          <ContactForm client:load />
        </div>
      </div>
    </div>
  </section>
</Layout>
