---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/contact/ContactForm';
import { Mail, Phone, MapPin, Clock } from 'lucide-react';
import { getSiteSettings } from '../lib/content-api';
import type { SiteData } from '../types';

const defaultSiteData: SiteData = {
  name: 'NexusHQ Technologies',
  abbreviation: 'NexusHQ',
  tagline: 'The Coaching Platform for Modern Mentors',
  contact: {
    email: 'hello@nexushq.tech',
    phone: '+1-800-NEXUS-HQ',
    address: 'Remote-first, Global'
  }
};

const siteData = (await getSiteSettings<SiteData>('site_data')) || defaultSiteData;

const schema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "@id": Astro.url.href,
  "url": Astro.url.href,
  "name": "Contact Us",
  "description": "Have questions about NexusHQ? Want to discuss enterprise plans or partnerships? We're here to help.",
  "mainEntity": {
    "@type": "Organization",
    "@id": `${Astro.url.origin}/#organization`,
    "name": siteData.name,
    "alternateName": siteData.abbreviation,
    "url": Astro.url.origin,
    "contactPoint": [
      {
        "@type": "ContactPoint",
        "telephone": siteData.contact.phone,
        "email": siteData.contact.email,
        "contactType": "customer service",
        "hoursAvailable": [
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
            "opens": "09:00",
            "closes": "18:00"
          }
        ]
      }
    ]
  }
};
---

<Layout title="Contact Us" schema={schema}>
  <!-- Hero Header -->
  <section class="border-b border-emerald-500/10 pt-32 pb-20 sm:pt-40 lg:pt-48 lg:pb-28 bg-gradient-to-b from-[#020408]/80 to-transparent">
    <div class="container mx-auto max-w-7xl px-6">
      <div class="max-w-3xl animate-fadeInUp">
        <h1 class="mb-6 font-heading text-4xl font-extrabold tracking-tight sm:text-5xl lg:text-6xl pb-2 text-white">
          Let's Start a <span class="bg-gradient-to-r from-emerald-400 via-teal-300 to-amber-300 bg-clip-text text-transparent inline-block pb-1">Conversation</span>
        </h1>
        <p class="text-xl leading-relaxed text-slate-300 font-light">
          Have questions about NexusHQ? Want to discuss enterprise plans, APIs, or custom integrations? We're here to help.
        </p>
      </div>
    </div>
  </section>

  <!-- Split Contact Section -->
  <section class="py-20 relative bg-[#020408]">
    <div class="absolute top-1/4 right-0 h-96 w-96 rounded-full bg-emerald-500/5 blur-3xl pointer-events-none" />
    <div class="absolute bottom-10 left-10 h-80 w-80 rounded-full bg-amber-500/5 blur-3xl pointer-events-none" />
    
    <div class="container mx-auto max-w-7xl px-6 relative z-10">
      <div class="grid gap-12 lg:grid-cols-2 lg:gap-16 items-start">
        
        <!-- Info Column -->
        <div class="space-y-12 animate-fadeInUp">
          <div>
            <h2 class="text-2xl font-bold tracking-tight text-white mb-6 font-heading">
              Contact Information
            </h2>
            <div class="grid gap-6">
              
              <!-- Address -->
              <div class="group flex items-start gap-4 rounded-2xl border border-emerald-500/15 bg-slate-950/50 p-5 hover:border-emerald-400/40 transition-all duration-300 glow-border">
                <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-emerald-500/10 text-emerald-400 transition-colors group-hover:bg-emerald-500 group-hover:text-black">
                  <MapPin className="h-5 w-5" />
                </div>
                <div class="space-y-1">
                  <p class="font-bold text-white text-xs uppercase tracking-wider font-mono">Headquarters</p>
                  <p class="text-slate-300 text-base leading-relaxed font-medium">{siteData.contact.address}</p>
                </div>
              </div>

              <!-- Email -->
              <div class="group flex items-start gap-4 rounded-2xl border border-emerald-500/15 bg-slate-950/50 p-5 hover:border-emerald-400/40 transition-all duration-300 glow-border">
                <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-emerald-500/10 text-emerald-400 transition-colors group-hover:bg-emerald-500 group-hover:text-black">
                  <Mail className="h-5 w-5" />
                </div>
                <div class="space-y-1">
                  <p class="font-bold text-white text-xs uppercase tracking-wider font-mono">Email</p>
                  <a href={`mailto:${siteData.contact.email}`} class="text-slate-300 text-base font-medium hover:text-emerald-400 transition-colors block">
                    {siteData.contact.email}
                  </a>
                </div>
              </div>

              <!-- Phone -->
              <div class="group flex items-start gap-4 rounded-2xl border border-emerald-500/15 bg-slate-950/50 p-5 hover:border-emerald-400/40 transition-all duration-300 glow-border">
                <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-emerald-500/10 text-emerald-400 transition-colors group-hover:bg-emerald-500 group-hover:text-black">
                  <Phone className="h-5 w-5" />
                </div>
                <div class="space-y-1">
                  <p class="font-bold text-white text-xs uppercase tracking-wider font-mono">Phone</p>
                  <p class="text-slate-300 text-base font-medium font-mono">{siteData.contact.phone}</p>
                </div>
              </div>

            </div>
          </div>

          <!-- Support Hours -->
          <div class="rounded-2xl border border-emerald-500/15 bg-slate-950/50 p-6 space-y-4 glow-border">
            <h3 class="text-lg font-bold text-white flex items-center gap-2">
              <Clock className="h-5 w-5 text-emerald-400" />
              Support Hours
            </h3>
            <div class="grid grid-cols-2 gap-4 text-base text-slate-300 font-medium">
              <div>Monday &ndash; Friday</div>
              <div class="text-white font-bold font-mono">9:00 AM &ndash; 6:00 PM EST</div>
              <div>Saturday &ndash; Sunday</div>
              <div class="text-amber-400 font-semibold font-mono">Closed</div>
            </div>
          </div>
        </div>

        <!-- Form Column -->
        <ContactForm client:load />

      </div>
    </div>
  </section>
</Layout>
