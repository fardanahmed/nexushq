---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Terms" description="NexusHQ terms of service for the private beta.">
  <section class="pt-28 pb-24 lg:pt-36 lg:pb-32">
    <div class="container mx-auto max-w-6xl px-6">
      <div class="max-w-2xl">
        <h1 class="text-display">Terms</h1>
        <p class="mt-5 text-lead text-mist">
          NexusHQ is in private beta. This page will carry the full terms of service before launch. Until then, joining the waitlist creates no account and no obligation on either side.
        </p>
      </div>
    </div>
  </section>
</Layout>
